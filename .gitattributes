# Force Unix (LF) line endings across all platforms to prevent linter/formatter false positives (e.g. Biome)
* text=auto eol=lf

# Explicitly declare text files
*.go text eol=lf
*.templ text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
